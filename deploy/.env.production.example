# ═══════════════════════════════════════════════════════════════
# MamaSafe PRODUCTION environment — copy to .env.production and edit.
#   cp deploy/.env.production.example deploy/.env.production
# NEVER commit .env.production to Git.
#
# NOTE: deploy.sh links deploy/.env -> .env.production automatically so
# `docker compose` can interpolate ${VAR} references. For MANUAL compose
# runs, either create that link once (`ln -s .env.production deploy/.env`)
# or pass `--env-file deploy/.env.production`.
# ═══════════════════════════════════════════════════════════════

# ── Domains (no protocol) ──────────────────────────────────────
# Used by the Nginx reverse-proxy config and Certbot.
DOMAIN=yourdomain.com
API_DOMAIN=api.yourdomain.com
DOWNLOAD_DOMAIN=downloads.yourdomain.com

# ── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_DB=mamasafe
POSTGRES_USER=mamasafe_user
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_PASSWORD

# ── Backend auth ───────────────────────────────────────────────
# Generate: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ── CORS ───────────────────────────────────────────────────────
# Comma-separated origins the API will accept. Only your frontend
# domain(s). Ignored ("*") when set to *.
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── WhatsApp / Baileys ─────────────────────────────────────────
# These are the Docker-internal hostnames used by the compose stack.
BAILEYS_URL=http://whatsapp:3001
FASTAPI_URL=http://backend:8000
WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# ── Frontend build args ────────────────────────────────────────
# Leave VITE_API_URL empty to route /api through the same origin
# (recommended — avoids CORS entirely). Otherwise use the API URL.
VITE_API_URL=
# Android APK download (served from downloads.yourdomain.com)
VITE_APK_URL=https://downloads.yourdomain.com/mamasafe-v1.0.0.apk
VITE_APK_VERSION=1.0.0
VITE_APK_CHECKSUM=
# Quote values that contain spaces:
VITE_APK_CHANGELOG="Initial production release."

# ── Backups / monitoring ───────────────────────────────────────
BACKUP_DIR=/opt/mamasafe/backups
CONFIG_BACKUP_DIR=/opt/mamasafe/config-backups
BACKUP_KEEP=14
# Optional S3 destination, e.g. s3://my-bucket/mamasafe (empty = disabled)
S3_BUCKET=
